// Conic Platform — Full Production Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  BRAND
  CREATOR
  AGENCY
  ADMIN
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  PASSED
  FAILED
  FLAGGED
}

// ─── User & Identity ──────────────────────────────────────────────────────────

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 UserRole
  firstName            String
  lastName             String
  avatarUrl            String?
  emailVerified        Boolean        @default(false)
  emailVerificationToken String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorSecret      String?
  stripeCustomerId     String?
  lastLoginAt          DateTime?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  brand                Brand?
  creator              Creator?
  agency               Agency?

  auditLogs            AuditLog[]
  sentNotifications    Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  refreshTokens        RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Profiles ─────────────────────────────────────────────────────────────────

model Brand {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  website         String?
  industry        String?
  logoUrl         String?
  description     String?
  stripeAccountId String?
  stripeOnboarded Boolean    @default(false)
  totalSpend      Int        @default(0)
  creditBalance   Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contracts       Contract[]
  campaigns       Campaign[]

  @@index([userId])
}

model Creator {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle           String
  bio              String?
  platforms        Json                // { instagram: "handle", tiktok: "handle", youtube: "channelId" }
  primaryPlatform  String?
  niche            String[]
  followersCount   Int                 @default(0)
  engagementRate   Float               @default(0)
  avgReach         Int                 @default(0)
  audienceScore    Float               @default(0) // 0-100 authenticity
  fraudScore       Float               @default(0) // 0-100 fraud likelihood
  performanceScore Float               @default(0) // 0-100 predicted performance
  pricingTier      String?             // budget, mid, premium, celebrity
  rateCardJson     Json?               // { post: cents, story: cents, reel: cents, video: cents }
  stripeAccountId  String?
  stripeOnboarded  Boolean             @default(false)
  totalEarnings    Int                 @default(0)
  isVerified       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  contracts        Contract[]
  deliverables     Deliverable[]
  graphNode        CreatorGraphNode?
  predictions      CreatorPrediction[]

  @@index([userId])
  @@index([handle])
}

model Agency {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Contracts ────────────────────────────────────────────────────────────────

model Contract {
  id               String           @id @default(cuid())
  brandId          String
  brand            Brand            @relation(fields: [brandId], references: [id])
  creatorId        String
  creator          Creator          @relation(fields: [creatorId], references: [id])
  title            String
  status           ContractStatus   @default(DRAFT)
  content          String           @db.Text
  templateId       String?
  template         ContractTemplate? @relation(fields: [templateId], references: [id])
  usageRights      String?
  exclusivity      Boolean          @default(false)
  exclusivityDays  Int?
  platforms        String[]
  startDate        DateTime?
  endDate          DateTime?
  totalValue       Int              // in cents
  currency         String           @default("USD")
  riskScore        Int              @default(0) // 0-100
  riskFlags        Json?
  versionNumber    Int              @default(1)
  brandSignedAt    DateTime?
  brandSignerIp    String?
  creatorSignedAt  DateTime?
  creatorSignerIp  String?
  cancelledAt      DateTime?
  cancelReason     String?
  disputedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  deliverables     Deliverable[]
  payments         Payment[]
  versions         ContractVersion[]
  clauses          ContractClause[]
  milestones       PaymentMilestone[]

  @@index([brandId])
  @@index([creatorId])
  @@index([status])
}

model ContractTemplate {
  id          String     @id @default(cuid())
  name        String
  description String?
  content     String     @db.Text
  category    String     // influencer_post, ambassador, ugc, affiliate
  isPublic    Boolean    @default(false)
  createdBy   String?
  clauseCount Int        @default(0)
  usageCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contracts   Contract[]
}

model ContractVersion {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String   @db.Text
  changesSummary String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([contractId])
}

model ContractClause {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type        String   // payment, deliverable, usage_rights, exclusivity, termination, IP
  title       String
  content     String   @db.Text
  isStandard  Boolean  @default(false)
  riskLevel   String?  // low, medium, high
  aiSuggested Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([contractId])
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id                String              @id @default(cuid())
  contractId        String
  contract          Contract            @relation(fields: [contractId], references: [id])
  creatorId         String
  creator           Creator             @relation(fields: [creatorId], references: [id])
  title             String
  description       String?
  platform          String              // instagram, tiktok, youtube, twitter, linkedin
  contentType       String              // post, story, reel, video, tweet, article
  dueDate           DateTime
  status            DeliverableStatus   @default(PENDING)
  proofUrl          String?
  proofType         String?             // url, image, video, screenshot
  caption           String?             @db.Text
  hashtags          String[]
  mentions          String[]
  postUrl           String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationScore Float?              // 0-100
  verificationFlags Json?               // AI-detected issues
  verificationReport Json?              // full AI report
  revisionCount     Int                 @default(0)
  revisionHistory   Json?
  paymentAmount     Int?                // cents
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  payment           Payment?

  @@index([contractId])
  @@index([creatorId])
  @@index([status])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String         @id @default(cuid())
  contractId        String
  contract          Contract       @relation(fields: [contractId], references: [id])
  deliverableId     String?        @unique
  deliverable       Deliverable?   @relation(fields: [deliverableId], references: [id])
  milestoneId       String?
  milestone         PaymentMilestone? @relation(fields: [milestoneId], references: [id])
  amount            Int            // in cents
  currency          String         @default("USD")
  status            PaymentStatus  @default(PENDING)
  stripePaymentIntentId String?
  stripeTransferId  String?
  platformFeeRate   Float          @default(0.05) // 5%
  platformFee       Int            @default(0)
  netAmount         Int
  dueDate           DateTime?
  paidAt            DateTime?
  fraudScore        Float          @default(0) // 0-100
  fraudFlags        Json?
  description       String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([contractId])
  @@index([status])
}

model PaymentMilestone {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Int      // cents
  dueDate     DateTime?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  payments    Payment[]

  @@index([contractId])
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id              String          @id @default(cuid())
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id])
  title           String
  description     String?         @db.Text
  status          CampaignStatus  @default(DRAFT)
  objective       String?         // awareness, engagement, conversion, sales
  targetAudience  Json?           // { ageRange, gender, interests, locations }
  budget          Int?            // in cents
  spentBudget     Int             @default(0)
  startDate       DateTime?
  endDate         DateTime?
  platforms       String[]
  niche           String[]
  creatorCount    Int             @default(0)
  deliverableCount Int            @default(0)
  contractIds     String[]
  aiTimeline      Json?           // AI-generated timeline
  aiInsights      Json?           // latest AI analysis
  aiDebrief       Json?           // end-of-campaign AI debrief
  performanceData Json?           // aggregated metrics
  roi             Float?
  reach           Int             @default(0)
  impressions     Int             @default(0)
  engagements     Int             @default(0)
  conversions     Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tasks           CampaignTask[]
  summaries       CampaignSummary[]

  @@index([brandId])
  @@index([status])
}

model CampaignTask {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  aiGenerated Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId])
}

model CampaignSummary {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  period      String   // weekly, monthly, final
  content     String   @db.Text // AI-generated markdown
  pdfUrl      String?
  metrics     Json?
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

// ─── Creator Graph ────────────────────────────────────────────────────────────

model CreatorGraphNode {
  id               String              @id @default(cuid())
  creatorId        String              @unique
  creator          Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  clusterId        String?
  clusterLabel     String?
  centrality       Float               @default(0)
  influenceScore   Float               @default(0)
  botNetworkScore  Float               @default(0)
  audienceOverlap  Json?               // [{ creatorId, overlapPct }]
  trending         Boolean             @default(false)
  trendingScore    Float               @default(0)
  embeddingVector  Float[]             // graph embedding (stored as array)
  lastAnalyzedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  outgoingEdges    CreatorGraphEdge[]  @relation("EdgeSource")
  incomingEdges    CreatorGraphEdge[]  @relation("EdgeTarget")
}

model CreatorGraphEdge {
  id          String           @id @default(cuid())
  sourceId    String
  source      CreatorGraphNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      CreatorGraphNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  weight      Float            @default(1)
  edgeType    String           // audience_overlap, collaboration, niche_similar, mutual_mention
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model CreatorPrediction {
  id                  String   @id @default(cuid())
  creatorId           String
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  predictedReach      Int
  predictedEngagement Float
  predictedROI        Float
  audienceAuthenticity Float   // 0-1
  fraudLikelihood     Float    // 0-1
  confidence          Float    // 0-1
  modelVersion        String
  inputFeatures       Json?
  createdAt           DateTime @default(now())

  @@index([creatorId])
}

// ─── AI / ML ──────────────────────────────────────────────────────────────────

model AIModel {
  id          String   @id @default(cuid())
  name        String
  version     String
  type        String   // contract_gen, deliverable_verify, creator_score, pricing, graph_ml, campaign_agent
  endpoint    String
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, version])
}

model AIRequest {
  id            String   @id @default(cuid())
  modelType     String
  inputPayload  Json
  outputPayload Json?
  status        String   @default("pending") // pending, success, failed
  durationMs    Int?
  tokensUsed    Int?
  errorMessage  String?
  resourceType  String?  // contract, deliverable, creator, campaign
  resourceId    String?
  createdAt     DateTime @default(now())

  @@index([modelType])
  @@index([resourceType, resourceId])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  senderId    String?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  type        String   // contract_created, deliverable_submitted, payment_released, fraud_detected, etc.
  title       String
  body        String
  data        Json?
  read        Boolean  @default(false)
  readAt      DateTime?
  channelType String   @default("in_app") // in_app, email, sms
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
}

// ─── Audit & Compliance ───────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // USER_LOGIN, CONTRACT_CREATED, PAYMENT_RELEASED, etc.
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  responseStatus Int?
  responseBody  String?
  attempts      Int             @default(0)
  succeededAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime        @default(now())

  @@index([endpointId])
}

model ContactLead {
  id          String   @id @default(cuid())
  email       String
  name        String?
  company     String?
  role        String?  // brand, creator, agency
  message     String?
  source      String?
  utmParams   Json?
  convertedAt DateTime?
  createdAt   DateTime @default(now())
}
