// Conic Platform — Full Production Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl is used for migrations; both should include ?sslmode=require in production
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  BRAND
  CREATOR
  AGENCY
  ADMIN
  ATHLETE
  GUARDIAN
  AGENT
  COMPLIANCE_OFFICER
  COLLECTIVE_ADMIN
  UNIVERSITY_ADMIN
  ATHLETIC_DIRECTOR
}

enum ContractStatus {
  DRAFT
  PENDING_SIGNATURE
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliverableStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  DISPUTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  PASSED
  FAILED
  FLAGGED
}

// ─── NIL / Athlete Enums ──────────────────────────────────────────────────────

enum AthleteStatus {
  ENROLLED          // active NCAA/NAIA athlete
  PROFESSIONAL      // turned pro — no NIL restrictions
  TRANSFERRED       // in transfer portal
  GRADUATED         // graduated, eligibility exhausted
  INACTIVE
}

enum EligibilityStatus {
  ELIGIBLE
  INELIGIBLE
  UNDER_REVIEW
  SUSPENDED
}

enum NilDisclosureStatus {
  DRAFT
  PENDING_REVIEW    // sent to compliance officer
  APPROVED
  REJECTED
  EXPIRED           // beyond statutory window
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum AppearanceType {
  SPEAKING
  AUTOGRAPH_SIGNING
  PROMOTIONAL_EVENT
  ENDORSEMENT_APPEARANCE
  CAMP_OR_CLINIC
  VIRTUAL
  MEDIA_INTERVIEW
}

enum TaxDocumentType {
  W9
  W8BEN
  F1099NEC
  F1042S
}

enum TaxDocumentStatus {
  REQUESTED
  SUBMITTED
  VERIFIED
  EXPIRED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  ACKNOWLEDGED
  REQUIRES_CORRECTION
}

enum DivisionLevel {
  NCAA_D1
  NCAA_D2
  NCAA_D3
  NAIA
  NJCAA
  HIGH_SCHOOL
  PROFESSIONAL
  OTHER
}

// ─── User & Identity ──────────────────────────────────────────────────────────

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  passwordHash         String
  role                 UserRole
  firstName            String
  lastName             String
  avatarUrl            String?
  emailVerified        Boolean        @default(false)
  emailVerificationToken String?
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  twoFactorEnabled     Boolean        @default(false)
  twoFactorSecret      String?
  dwollaCustomerId     String?
  lastLoginAt          DateTime?
  isActive             Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  brand                Brand?
  creator              Creator?
  agency               Agency?
  athlete              Athlete?
  guardian             Guardian?
  agentProfile         AgentProfile?
  complianceOfficer    ComplianceOfficer?

  auditLogs            AuditLog[]
  sentNotifications    Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  refreshTokens        RefreshToken[]
  apiKeys              ApiKey[]
  importJobs           ImportJob[]
  dealRoomMessages     DealRoomMessage[]
  dealRoomProposals    DealRoomProposal[]
  matchRequests        MatchRequest[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Profiles ─────────────────────────────────────────────────────────────────

model Brand {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName     String
  website         String?
  industry        String?
  logoUrl         String?
  description     String?
  dwollaCustomerId String?
  dwollaVerified  Boolean    @default(false)
  totalSpend      Int        @default(0)
  creditBalance   Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  contracts       Contract[]
  campaigns       Campaign[]
  nilDeals        NilDeal[]
  appearances     Appearance[]

  @@index([userId])
}

model Creator {
  id               String              @id @default(cuid())
  userId           String              @unique
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  handle           String
  bio              String?
  platforms        Json                // legacy handle map; superseded by SocialAccount rows
  primaryPlatform  String?
  niche            String[]
  // Self-provided profile attributes for discovery search (never scraped/inferred)
  contentStyle     String[]            // e.g. minimalist, luxury, streetwear
  aestheticTags    String[]
  languages        String[]
  city             String?
  region           String?
  country          String?
  followersCount   Int                 @default(0)
  engagementRate   Float               @default(0)
  avgReach         Int                 @default(0)
  audienceScore    Float               @default(0) // 0-100 authenticity
  fraudScore       Float               @default(0) // 0-100 fraud likelihood
  performanceScore Float               @default(0) // 0-100 predicted performance
  pricingTier      String?             // budget, mid, premium, celebrity
  rateCardJson     Json?               // { post: cents, story: cents, reel: cents, video: cents }
  dwollaCustomerId String?
  dwollaVerified   Boolean             @default(false)
  totalEarnings    Int                 @default(0)
  isVerified       Boolean             @default(false)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  contracts        Contract[]
  deliverables     Deliverable[]
  graphNode        CreatorGraphNode?
  predictions      CreatorPrediction[]
  featureVectors   FeatureVector[]
  embeddings       EmbeddingRecord[]
  taxDocuments     TaxDocument[]
  fmvAssessments   FmvAssessment[]
  matchResults     MatchResult[]
  socialAccounts   SocialAccount[]

  @@index([userId])
  @@index([handle])
  @@index([performanceScore])
  @@index([followersCount])
  @@index([engagementRate])
  @@index([fraudScore])
  @@index([audienceScore])
  @@index([pricingTier])
  @@index([isVerified])
  @@index([primaryPlatform])
  @@index([createdAt])
}

model Agency {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ─── Contracts ────────────────────────────────────────────────────────────────

model Contract {
  id               String           @id @default(cuid())
  brandId          String
  brand            Brand            @relation(fields: [brandId], references: [id])
  creatorId        String
  creator          Creator          @relation(fields: [creatorId], references: [id])
  title            String
  status           ContractStatus   @default(DRAFT)
  content          String           @db.Text
  templateId       String?
  template         ContractTemplate? @relation(fields: [templateId], references: [id])
  usageRights      String?
  exclusivity      Boolean          @default(false)
  exclusivityDays  Int?
  platforms        String[]
  startDate        DateTime?
  endDate          DateTime?
  totalValue       Int              // in cents
  currency         String           @default("USD")
  riskScore        Int              @default(0) // 0-100
  riskFlags        Json?
  versionNumber    Int              @default(1)
  brandSignedAt    DateTime?
  brandSignerIp    String?
  creatorSignedAt  DateTime?
  creatorSignerIp  String?
  cancelledAt      DateTime?
  cancelReason     String?
  disputedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  deliverables     Deliverable[]
  payments         Payment[]
  versions         ContractVersion[]
  clauses          ContractClause[]
  milestones       PaymentMilestone[]
  nilExtension     ContractNilExtension?
  nilDeals         NilDeal[]
  dealRoom         DealRoom?

  @@index([brandId])
  @@index([creatorId])
  @@index([status])
}

model ContractTemplate {
  id            String     @id @default(cuid())
  name          String
  description   String?
  content       String     @db.Text
  category      String     // influencer_post, ambassador, ugc, affiliate, nil_endorsement
  isPublic      Boolean    @default(false)
  isNilTemplate Boolean    @default(false)
  createdBy     String?
  platforms     String[]
  tags          String[]
  riskScore     Int?
  clauseCount   Int        @default(0)
  usageCount    Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  contracts     Contract[]

  @@index([isPublic])
  @@index([isNilTemplate])
}

model ContractVersion {
  id            String   @id @default(cuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber Int
  content       String   @db.Text
  changesSummary String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([contractId])
}

model ContractClause {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  type        String   // payment, deliverable, usage_rights, exclusivity, termination, IP
  title       String
  content     String   @db.Text
  isStandard  Boolean  @default(false)
  riskLevel   String?  // low, medium, high
  aiSuggested Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([contractId])
}

// ─── Deliverables ─────────────────────────────────────────────────────────────

model Deliverable {
  id                String              @id @default(cuid())
  contractId        String
  contract          Contract            @relation(fields: [contractId], references: [id])
  creatorId         String
  creator           Creator             @relation(fields: [creatorId], references: [id])
  title             String
  description       String?
  platform          String              // instagram, tiktok, youtube, twitter, linkedin
  contentType       String              // post, story, reel, video, tweet, article
  dueDate           DateTime
  status            DeliverableStatus   @default(PENDING)
  proofUrl          String?
  proofType         String?             // url, image, video, screenshot
  caption           String?             @db.Text
  hashtags          String[]
  mentions          String[]
  postUrl           String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationScore Float?              // 0-100
  verificationFlags Json?               // AI-detected issues
  verificationReport Json?              // full AI report
  revisionCount     Int                 @default(0)
  revisionHistory   Json?
  paymentAmount     Int?                // cents
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  payment           Payment?

  @@index([contractId])
  @@index([creatorId])
  @@index([status])
  @@index([creatorId, status])
  @@index([dueDate])
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id                String         @id @default(cuid())
  contractId        String
  contract          Contract       @relation(fields: [contractId], references: [id])
  deliverableId     String?        @unique
  deliverable       Deliverable?   @relation(fields: [deliverableId], references: [id])
  milestoneId       String?
  milestone         PaymentMilestone? @relation(fields: [milestoneId], references: [id])
  amount            Int            // in cents
  currency          String         @default("USD")
  status            PaymentStatus  @default(PENDING)
  dwollaTransferId  String?
  platformFeeRate   Float          @default(0.05) // 5%
  platformFee       Int            @default(0)
  netAmount         Int
  dueDate           DateTime?
  paidAt            DateTime?
  fraudScore        Float          @default(0) // 0-100
  fraudFlags        Json?
  description       String?
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([contractId])
  @@index([status])
  @@index([contractId, status])
  @@index([createdAt])
}

model PaymentMilestone {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Int      // cents
  dueDate     DateTime?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  payments    Payment[]

  @@index([contractId])
}

// ─── Campaigns ────────────────────────────────────────────────────────────────

model Campaign {
  id              String          @id @default(cuid())
  brandId         String
  brand           Brand           @relation(fields: [brandId], references: [id])
  deletedAt       DateTime?
  title           String
  description     String?         @db.Text
  status          CampaignStatus  @default(DRAFT)
  objective       String?         // awareness, engagement, conversion, sales
  targetAudience  Json?           // { ageRange, gender, interests, locations }
  budget          Int?            // in cents
  spentBudget     Int             @default(0)
  startDate       DateTime?
  endDate         DateTime?
  platforms       String[]
  niche           String[]
  creatorCount    Int             @default(0)
  deliverableCount Int            @default(0)
  contractIds     String[]
  aiTimeline      Json?           // AI-generated timeline
  aiInsights      Json?           // latest AI analysis
  aiDebrief       Json?           // end-of-campaign AI debrief
  performanceData Json?           // aggregated metrics
  roi             Float?
  reach           Int             @default(0)
  impressions     Int             @default(0)
  engagements     Int             @default(0)
  conversions     Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tasks           CampaignTask[]
  summaries       CampaignSummary[]

  @@index([brandId])
  @@index([status])
  @@index([brandId, status])
  @@index([deletedAt])
}

model CampaignTask {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  completedAt DateTime?
  aiGenerated Boolean  @default(false)
  priority    String?  @default("MEDIUM") // LOW, MEDIUM, HIGH
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([campaignId])
  @@index([campaignId, completed])
}

model CampaignSummary {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  period      String   // weekly, monthly, final
  content     String   @db.Text // AI-generated markdown
  pdfUrl      String?
  metrics     Json?
  createdAt   DateTime @default(now())

  @@index([campaignId])
}

// ─── Creator Graph ────────────────────────────────────────────────────────────

model CreatorGraphNode {
  id               String              @id @default(cuid())
  creatorId        String              @unique
  creator          Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  clusterId        String?
  clusterLabel     String?
  centrality       Float               @default(0)
  influenceScore   Float               @default(0)
  botNetworkScore  Float               @default(0)
  audienceOverlap  Json?               // [{ creatorId, overlapPct }]
  trending         Boolean             @default(false)
  trendingScore    Float               @default(0)
  embeddingVector  Float[]             // graph embedding (stored as array)
  lastAnalyzedAt   DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  outgoingEdges    CreatorGraphEdge[]  @relation("EdgeSource")
  incomingEdges    CreatorGraphEdge[]  @relation("EdgeTarget")
}

model CreatorGraphEdge {
  id          String           @id @default(cuid())
  sourceId    String
  source      CreatorGraphNode @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  targetId    String
  target      CreatorGraphNode @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)
  weight      Float            @default(1)
  edgeType    String           // audience_overlap, collaboration, niche_similar, mutual_mention
  metadata    Json?
  createdAt   DateTime         @default(now())

  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model CreatorPrediction {
  id                  String   @id @default(cuid())
  creatorId           String
  creator             Creator  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  predictedReach      Int
  predictedEngagement Float
  predictedROI        Float
  audienceAuthenticity Float   // 0-1
  fraudLikelihood     Float    // 0-1
  confidence          Float    // 0-1
  modelVersion        String
  inputFeatures       Json?
  createdAt           DateTime @default(now())

  @@index([creatorId])
}

// ─── AI / ML ──────────────────────────────────────────────────────────────────

model AIModel {
  id          String   @id @default(cuid())
  name        String
  version     String
  type        String   // contract_gen, deliverable_verify, creator_score, pricing, graph_ml, campaign_agent
  endpoint    String
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, version])
}

model AIRequest {
  id            String   @id @default(cuid())
  modelType     String
  inputPayload  Json
  outputPayload Json?
  status        String   @default("pending") // pending, success, failed
  durationMs    Int?
  tokensUsed    Int?     @default(0)
  costUsd       Float?   @default(0)
  errorMessage  String?
  resourceType  String?  // contract, deliverable, creator, campaign
  resourceId    String?
  modelVersion  String?
  createdAt     DateTime @default(now())

  @@index([modelType])
  @@index([resourceType, resourceId])
  @@index([status])
  @@index([createdAt])
}

// ─── Feature Store (ML Data Flywheel) ────────────────────────────────────────

model FeatureVector {
  id           String   @id @default(cuid())
  creatorId    String?
  creator      Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entityType   String   // creator, contract, deliverable, campaign
  entityId     String
  featureSet   String   // scoring, pricing, fraud, engagement
  version      Int      @default(1)
  features     Json     // { key: value } feature map
  computedAt   DateTime @default(now())
  expiresAt    DateTime?

  @@index([entityType, entityId])
  @@index([creatorId])
  @@index([featureSet])
  @@index([computedAt])
}

model EmbeddingRecord {
  id           String   @id @default(cuid())
  creatorId    String?
  creator      Creator? @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  entityType   String   // creator, clause, contract, deliverable
  entityId     String
  embeddingType String  // profile, graph, clause, style
  model        String   // text-embedding-3-small, node2vec-v1, etc.
  dimensions   Int
  vector       Float[]
  metadata     Json?
  createdAt    DateTime @default(now())

  @@unique([entityType, entityId, embeddingType, model])
  @@index([entityType, entityId])
  @@index([creatorId])
}

model ModelRegistry {
  id           String   @id @default(cuid())
  name         String
  version      String
  type         String   // scoring, pricing, fraud, graph, contract_risk
  endpoint     String?
  artifactPath String?
  metrics      Json?    // { accuracy, f1, auc, ... }
  isActive     Boolean  @default(false)
  isChampion   Boolean  @default(false)  // the production model
  trainedAt    DateTime?
  promotedAt   DateTime?
  metadata     Json?
  createdAt    DateTime @default(now())

  driftAlerts  ModelDriftAlert[]

  @@unique([name, version])
  @@index([type, isActive])
  @@index([isChampion])
}

model ModelDriftAlert {
  id            String        @id @default(cuid())
  modelId       String
  model         ModelRegistry @relation(fields: [modelId], references: [id], onDelete: Cascade)
  metricName    String
  baseline      Float
  observed      Float
  driftScore    Float
  severity      String        // low, medium, high, critical
  resolved      Boolean       @default(false)
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())

  @@index([modelId])
  @@index([severity, resolved])
  @@index([createdAt])
}

model DataFlywheelEvent {
  id           String   @id @default(cuid())
  eventType    String   // contract.signed, deliverable.approved, payment.completed, ...
  sourceEntity String   // creator, contract, deliverable, campaign, payment
  sourceId     String
  payload      Json
  processed    Boolean  @default(false)
  processedAt  DateTime?
  processingMs Int?
  featuresFed  String[] // which feature sets were updated
  createdAt    DateTime @default(now())

  @@index([eventType])
  @@index([sourceEntity, sourceId])
  @@index([processed, createdAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(cuid())
  senderId    String?
  sender      User?    @relation("SentNotifications", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("ReceivedNotifications", fields: [recipientId], references: [id])
  type        String   // contract_created, deliverable_submitted, payment_released, fraud_detected, etc.
  title       String
  body        String
  data        Json?
  read        Boolean  @default(false)
  readAt      DateTime?
  channelType String   @default("in_app") // in_app, email, sms
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
}

// ─── Audit & Compliance ───────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  action      String   // USER_LOGIN, CONTRACT_CREATED, PAYMENT_RELEASED, etc.
  resource    String
  resourceId  String?
  oldValue    Json?
  newValue    Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

model WebhookEndpoint {
  id        String   @id @default(cuid())
  url       String
  secret    String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String          @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  responseStatus Int?
  responseBody  String?
  attempts      Int             @default(0)
  succeededAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime        @default(now())

  @@index([endpointId])
}

model ContactLead {
  id          String   @id @default(cuid())
  email       String
  name        String?
  company     String?
  role        String?  // brand, creator, agency
  message     String?
  source      String?
  utmParams   Json?
  convertedAt DateTime?
  createdAt   DateTime @default(now())
}

// ═══════════════════════════════════════════════════════════════════════════════
// NIL + Athlete Ecosystem
// ═══════════════════════════════════════════════════════════════════════════════

// ─── University & Athletic Department ─────────────────────────────────────────

model University {
  id                  String              @id @default(cuid())
  name                String
  shortName           String              // e.g. "UCLA"
  ncaaSchoolId        String?             @unique
  division            DivisionLevel       @default(NCAA_D1)
  conference          String?
  state               String?
  country             String              @default("US")
  website             String?
  logoUrl             String?
  primaryColor        String?
  nilProgramActive    Boolean             @default(true)
  nilPolicy           Json?               // school-specific NIL rules
  reportingEmail      String?
  reportingWindowDays Int                 @default(30)
  disclosureRequired  Boolean             @default(true)
  disclosureThreshold Int                 @default(0)  // cents; 0 = all deals
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  athleticDepartments AthleticDepartment[]
  athletes            Athlete[]
  complianceOfficers  ComplianceOfficer[]
  complianceReports   ComplianceReport[]
  nilCollectives      NilCollective[]

  @@index([state])
  @@index([division])
  @@index([ncaaSchoolId])
}

model AthleticDepartment {
  id           String     @id @default(cuid())
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  sport        String     // football, basketball, soccer, etc.
  gender       String     // mens, womens, mixed
  headCoach    String?
  contactEmail String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  athletes     Athlete[]

  @@unique([universityId, sport, gender])
  @@index([universityId])
  @@index([sport])
}

model ComplianceOfficer {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId String
  university   University  @relation(fields: [universityId], references: [id])
  title        String?
  phone        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([universityId])
}

// ─── Athlete ───────────────────────────────────────────────────────────────────

model Athlete {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId          String?
  university            University?        @relation(fields: [universityId], references: [id])
  athleticDepartmentId  String?
  athleticDepartment    AthleticDepartment? @relation(fields: [athleticDepartmentId], references: [id])
  sport                 String
  position              String?
  jerseyNumber          String?
  classYear             String?            // Freshman, Sophomore, Junior, Senior, Graduate
  graduationYear        Int?
  status                AthleteStatus      @default(ENROLLED)
  eligibilityStatus     EligibilityStatus  @default(ELIGIBLE)
  eligibilityYearsLeft  Int?
  ncaaId                String?            @unique
  // NIL Program
  nilActive             Boolean            @default(false)
  nilCapCents           Int?               // school/state NIL annual cap (null = unlimited)
  nilEarnedYtdCents     Int                @default(0)
  nilDisclosureRequired Boolean            @default(true)
  // Performance & Social
  followersCount        Int                @default(0)
  engagementRate        Float              @default(0)
  primaryPlatform       String?
  platforms             Json?              // legacy handle map; superseded by SocialAccount rows
  // Self-provided profile attributes for discovery search (never scraped/inferred)
  contentStyle          String[]
  aestheticTags         String[]
  languages             String[]
  city                  String?
  region                String?
  country               String?
  audienceScore         Float              @default(0)
  fraudScore            Float              @default(0)
  performanceScore      Float              @default(0)
  fmvMinCents           Int?               // AI-generated FMV floor
  fmvMaxCents           Int?               // AI-generated FMV ceiling
  fmvLastAssessedAt     DateTime?
  // Financial
  dwollaCustomerId      String?
  dwollaVerified        Boolean            @default(false)
  totalEarningsNilCents Int                @default(0)
  isVerified            Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  guardians             GuardianRelationship[]
  agentRelationships    AgentRepresentation[]
  nilDisclosures        NilDisclosure[]
  appearances           Appearance[]
  nilDeals              NilDeal[]
  fmvAssessments        FmvAssessment[]
  taxDocuments          TaxDocument[]
  graphNode             AthleteGraphNode?
  marketplaceListing    NilMarketplaceListing?
  collectiveMemberships CollectiveMember[]
  matchResults          MatchResult[]
  socialAccounts        SocialAccount[]

  @@index([userId])
  @@index([universityId])
  @@index([sport])
  @@index([status])
  @@index([eligibilityStatus])
  @@index([nilActive])
  @@index([performanceScore])
}

// ─── Guardian ─────────────────────────────────────────────────────────────────

model Guardian {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone             String?
  relationship      String                 // parent, legal_guardian, etc.
  isVerified        Boolean                @default(false)
  verifiedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  athleteRelationships GuardianRelationship[]
  approvals            GuardianApproval[]

  @@index([userId])
}

model GuardianRelationship {
  id          String    @id @default(cuid())
  guardianId  String
  guardian    Guardian  @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  relationship String   // mother, father, legal_guardian
  isPrimary   Boolean   @default(false)
  canApprove  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@unique([guardianId, athleteId])
  @@index([guardianId])
  @@index([athleteId])
}

model GuardianApproval {
  id             String         @id @default(cuid())
  guardianId     String
  guardian       Guardian       @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  resourceType   String         // nil_deal, contract, appearance, disclosure
  resourceId     String
  status         ApprovalStatus @default(PENDING)
  requestedAt    DateTime       @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime
  notes          String?
  ipAddress      String?
  createdAt      DateTime       @default(now())

  @@index([guardianId])
  @@index([resourceType, resourceId])
  @@index([status])
}

// ─── Agent ────────────────────────────────────────────────────────────────────

model AgentProfile {
  id              String                @id @default(cuid())
  userId          String                @unique
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  agencyName      String?
  licenseNumber   String?
  licenseState    String?
  website         String?
  phone           String?
  bio             String?
  isVerified      Boolean               @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  representations AgentRepresentation[]

  @@index([userId])
}

model AgentRepresentation {
  id              String      @id @default(cuid())
  agentId         String
  agent           AgentProfile @relation(fields: [agentId], references: [id], onDelete: Cascade)
  athleteId       String
  athlete         Athlete     @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  scope           String[]    // nil_deals, appearances, social_media, full_representation
  commissionRate  Float       @default(0.15)
  contractUrl     String?
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([agentId, athleteId])
  @@index([agentId])
  @@index([athleteId])
  @@index([isActive])
}

// ─── NIL Collective ───────────────────────────────────────────────────────────

model NilCollective {
  id                String        @id @default(cuid())
  name              String
  slug              String        @unique
  universityId      String?
  university        University?   @relation(fields: [universityId], references: [id])
  sport             String?       // null = all sports
  website           String?
  logoUrl           String?
  description       String?       @db.Text
  contactEmail      String?
  ein               String?       // tax ID
  isVerified        Boolean       @default(false)
  totalFundsRaisedCents Int       @default(0)
  totalPaidOutCents     Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  nilDeals          NilDeal[]
  members           CollectiveMember[]
  donors            CollectiveDonor[]
  donations         CollectiveDonation[]
  distributions     CollectiveDistribution[]

  @@index([universityId])
  @@index([sport])
}

// ─── NIL Deal ─────────────────────────────────────────────────────────────────

model NilDeal {
  id                 String              @id @default(cuid())
  athleteId          String
  athlete            Athlete             @relation(fields: [athleteId], references: [id])
  collectiveId       String?
  collective         NilCollective?      @relation(fields: [collectiveId], references: [id])
  brandId            String?
  brand              Brand?              @relation(fields: [brandId], references: [id])
  title              String
  description        String?             @db.Text
  dealType           String              // endorsement, appearance, social_post, licensing, camp
  valueCents         Int
  currency           String              @default("USD")
  fmvAssessmentId    String?
  fmvAssessment      FmvAssessment?      @relation(fields: [fmvAssessmentId], references: [id])
  startDate          DateTime?
  endDate            DateTime?
  disclosureId       String?
  disclosure         NilDisclosure?      @relation(fields: [disclosureId], references: [id])
  contractId         String?
  contract           Contract?           @relation(fields: [contractId], references: [id])
  guardianApproved   Boolean             @default(false)
  agentApproved      Boolean             @default(false)
  complianceApproved Boolean             @default(false)
  status             String              @default("PENDING") // PENDING, ACTIVE, COMPLETED, CANCELLED
  aiRiskScore        Int                 @default(0)
  aiRiskFlags        Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([athleteId])
  @@index([collectiveId])
  @@index([brandId])
  @@index([status])
  @@index([createdAt])
}

// ─── NIL Disclosure ───────────────────────────────────────────────────────────

model NilDisclosure {
  id                  String              @id @default(cuid())
  athleteId           String
  athlete             Athlete             @relation(fields: [athleteId], references: [id])
  universityId        String?
  dealType            String              // endorsement, appearance, social_post, licensing
  brandName           String
  dealValueCents      Int
  startDate           DateTime
  endDate             DateTime?
  description         String?
  platforms           String[]
  status              NilDisclosureStatus @default(DRAFT)
  submittedAt         DateTime?
  reviewedAt          DateTime?
  reviewedBy          String?             // complianceOfficer userId
  reviewNotes         String?
  // Auto-generated by AI
  aiGeneratedSummary  String?
  aiComplianceFlags   Json?
  aiStateRules        Json?               // applicable state laws
  aiNcaaRules         Json?               // NCAA rules triggered
  // Documents
  contractUrl         String?
  supportingDocUrls   String[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  nilDeals            NilDeal[]
  contractExtensions  ContractNilExtension[]

  @@index([athleteId])
  @@index([universityId])
  @@index([status])
  @@index([createdAt])
}

// ─── Appearance ───────────────────────────────────────────────────────────────

model Appearance {
  id                String          @id @default(cuid())
  athleteId         String
  athlete           Athlete         @relation(fields: [athleteId], references: [id])
  brandId           String?
  brand             Brand?          @relation(fields: [brandId], references: [id])
  nilDealId         String?
  type              AppearanceType
  title             String
  description       String?
  venueName         String?
  venueAddress      String?
  city              String?
  state             String?
  scheduledAt       DateTime
  durationMinutes   Int             @default(60)
  compensationCents Int
  currency          String          @default("USD")
  status            String          @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  confirmationCode  String?
  guardinApprovalId String?
  travelIncluded    Boolean         @default(false)
  travelDetails     Json?
  checkInAt         DateTime?
  checkOutAt        DateTime?
  proofUrl          String?         // photo proof of appearance
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([athleteId])
  @@index([brandId])
  @@index([scheduledAt])
  @@index([status])
}

// ─── Tax Documents ────────────────────────────────────────────────────────────

model TaxDocument {
  id              String            @id @default(cuid())
  athleteId       String?
  athlete         Athlete?          @relation(fields: [athleteId], references: [id])
  creatorId       String?
  creator         Creator?          @relation(fields: [creatorId], references: [id])
  type            TaxDocumentType
  taxYear         Int
  status          TaxDocumentStatus @default(REQUESTED)
  documentUrl     String?           // encrypted S3 URL
  ssn_last4       String?           // last 4 only, never full SSN
  businessName    String?
  addressLine1    String?
  city            String?
  state           String?
  zip             String?
  totalAmountCents Int?
  requestedAt     DateTime          @default(now())
  submittedAt     DateTime?
  verifiedAt      DateTime?
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([athleteId])
  @@index([creatorId])
  @@index([taxYear])
  @@index([type, status])
}

// ─── FMV Assessment ───────────────────────────────────────────────────────────

model FmvAssessment {
  id                  String    @id @default(cuid())
  athleteId           String?
  athlete             Athlete?  @relation(fields: [athleteId], references: [id])
  creatorId           String?
  creator             Creator?  @relation(fields: [creatorId], references: [id])
  dealType            String    // endorsement, appearance, social_post, licensing
  sport               String?
  platform            String?
  followersCount      Int?
  engagementRate      Float?
  marketTier          String?   // local, regional, national, international
  fmvMinCents         Int
  fmvMaxCents         Int
  fmvMedianCents      Int
  confidenceScore     Float     // 0-1
  comparableDeals     Json?     // anonymized comps
  eligibilityRisk     String?   // low, medium, high — risk of exceeding FMV = endorsement
  aiModel             String
  riskFlags           Json?
  rawFactors          Json?     // input features used
  createdAt           DateTime  @default(now())

  nilDeals            NilDeal[]

  @@index([athleteId])
  @@index([creatorId])
  @@index([dealType])
  @@index([createdAt])
}

// ─── Compliance Reports (School Reporting) ────────────────────────────────────

model ComplianceReport {
  id                  String        @id @default(cuid())
  universityId        String
  university          University    @relation(fields: [universityId], references: [id])
  reportType          String        // monthly, quarterly, annual, ad_hoc
  period              String        // e.g. "2024-Q1", "2024-12"
  status              ReportStatus  @default(DRAFT)
  athleteCount        Int           @default(0)
  dealCount           Int           @default(0)
  totalValueCents     Int           @default(0)
  disclosureCount     Int           @default(0)
  pendingDisclosures  Int           @default(0)
  flaggedDeals        Int           @default(0)
  // AI-generated narrative
  aiSummary           String?       @db.Text
  aiRiskNarrative     String?       @db.Text
  aiRecommendations   Json?
  // Structured data
  dealsByType         Json?         // { endorsement: 12, appearance: 4, ... }
  dealsBySport        Json?         // { football: 30, basketball: 15, ... }
  dealsTimeline       Json?         // monthly breakdown
  topEarners          Json?         // anonymized top-N athletes
  // Report document
  pdfUrl              String?
  csvUrl              String?
  submittedAt         DateTime?
  acknowledgedAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([universityId])
  @@index([reportType, period])
  @@index([status])
}

// ─── Athlete Identity Graph ───────────────────────────────────────────────────

model AthleteGraphNode {
  id                String              @id @default(cuid())
  athleteId         String              @unique
  athlete           Athlete             @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  clusterId         String?
  clusterLabel      String?             // e.g. "SEC Football Skill Players"
  centralityScore   Float               @default(0)
  influenceScore    Float               @default(0)
  botNetworkScore   Float               @default(0)
  audienceOverlap   Json?
  crossSportReach   Json?              // estimated reach in other sports' audiences
  trending          Boolean             @default(false)
  trendingScore     Float               @default(0)
  brandFitScores    Json?              // { brand_category: score }
  embeddingVector   Float[]
  lastAnalyzedAt    DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([clusterId])
  @@index([influenceScore])
}

// ─── Contract NIL extension ───────────────────────────────────────────────────
// Extend existing Contract to support NIL-specific fields via a separate table

model ContractNilExtension {
  id                    String    @id @default(cuid())
  contractId            String    @unique
  contract              Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  athleteId             String?
  nilDealId             String?
  isNilContract         Boolean   @default(true)
  ncaaCompliant         Boolean?
  stateCompliant        Boolean?
  universityApproved    Boolean   @default(false)
  universityApprovedAt  DateTime?
  guardianSignatureRequired Boolean @default(false)
  guardianSignedAt      DateTime?
  guardianSignerIp      String?
  agentSignatureRequired Boolean  @default(false)
  agentSignedAt         DateTime?
  disclosureId          String?
  disclosure            NilDisclosure? @relation(fields: [disclosureId], references: [id])
  applicableStateLaws   String[]
  ncaaRules             Json?
  exclusivitySports     String[]  // sports excluded from future deals
  fmvVerified           Boolean   @default(false)
  fmvAssessmentId       String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([contractId])
  @@index([athleteId])
}

// ─── API Keys (Ecosystem / SDK Moat) ─────────────────────────────────────────

model ApiKey {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  keyHash      String    @unique
  prefix       String
  scopes       String[]
  lastUsedAt   DateTime?
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  requestCount BigInt    @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([keyHash])
}

// ─── NIL Marketplace ─────────────────────────────────────────────────────────

model NilMarketplaceListing {
  id                   String   @id @default(cuid())
  athleteId            String   @unique
  athlete              Athlete  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  headline             String
  bio                  String?
  sport                String
  preferredDealTypes   String[]
  minDealValueCents    Int      @default(0)
  socialFollowersTotal Int      @default(0)
  engagementRatePct    Float?
  audienceAgeRange     String?
  audienceGenderSplit  Json?
  topAudienceLocations String[]
  isVisible            Boolean  @default(true)
  featuredImageUrl     String?
  verifiedByPlatform   Boolean  @default(false)
  viewCount            Int      @default(0)
  inquiryCount         Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([sport])
  @@index([isVisible])
  @@index([minDealValueCents])
}

// ─── SCIM Provisioning ────────────────────────────────────────────────────────

model ScimToken {
  id          String    @id @default(cuid())
  tenantId    String
  tenantType  String
  tokenHash   String    @unique
  description String?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// ─── Import Jobs (Data Moat / Switching Cost) ─────────────────────────────────

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
}

enum ImportType {
  CREATOR_CSV
  ATHLETE_CSV
  CONTRACT_CSV
  NIL_DEAL_CSV
  OPENDORSE_EXPORT
  TEAMWORKS_EXPORT
  GENERIC_CSV
}

model ImportJob {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id])
  type          ImportType
  status        ImportJobStatus @default(PENDING)
  fileName      String
  fileUrl       String?
  totalRows     Int             @default(0)
  processedRows Int             @default(0)
  errorRows     Int             @default(0)
  errors        Json?
  mappingConfig Json?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Deal Room — Live Negotiation Hub
// ═══════════════════════════════════════════════════════════════════════════════

enum DealRoomStatus {
  OPEN          // negotiation in progress
  AGREED        // both parties accepted final terms
  CLOSED        // closed without agreement
  ABANDONED     // one party stopped responding
}

enum DealRoomMessageType {
  COMMENT
  COUNTEROFFER
  ACCEPTANCE
  REJECTION
  AI_SUGGESTION
  SYSTEM
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTERED
  WITHDRAWN
}

model DealRoom {
  id          String          @id @default(cuid())
  contractId  String          @unique
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  status      DealRoomStatus  @default(OPEN)
  openedAt    DateTime        @default(now())
  agreedAt    DateTime?
  closedAt    DateTime?
  messages    DealRoomMessage[]
  proposals   DealRoomProposal[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([contractId])
  @@index([status])
}

model DealRoomMessage {
  id          String              @id @default(cuid())
  dealRoomId  String
  dealRoom    DealRoom            @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation(fields: [authorId], references: [id])
  content     String              @db.Text
  clauseRef   String?             // optional: which clause this message references
  type        DealRoomMessageType @default(COMMENT)
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([dealRoomId])
  @@index([authorId])
  @@index([dealRoomId, createdAt])
}

model DealRoomProposal {
  id            String          @id @default(cuid())
  dealRoomId    String
  dealRoom      DealRoom        @relation(fields: [dealRoomId], references: [id], onDelete: Cascade)
  proposedById  String
  proposedBy    User            @relation(fields: [proposedById], references: [id])
  title         String
  changes       Json            // [{ clauseType, original, proposed }]
  aiRiskDelta   Int?            // change in risk score vs current contract
  aiSummary     String?         // AI plain-language summary of changes
  status        ProposalStatus  @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([dealRoomId])
  @@index([proposedById])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════════
// Collective Portal — NIL Collective Management
// ═══════════════════════════════════════════════════════════════════════════════

enum CollectiveMemberStatus {
  ACTIVE
  INACTIVE
  PENDING
  REMOVED
}

model CollectiveMember {
  id            String                 @id @default(cuid())
  collectiveId  String
  collective    NilCollective          @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       Athlete                @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sharePercent  Float                  @default(0)   // percentage of distributions
  joinedAt      DateTime               @default(now())
  leftAt        DateTime?
  status        CollectiveMemberStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  distributions CollectiveDistribution[]

  @@unique([collectiveId, athleteId])
  @@index([collectiveId])
  @@index([athleteId])
  @@index([status])
}

model CollectiveDonor {
  id                String        @id @default(cuid())
  collectiveId      String
  collective        NilCollective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
  displayName       String
  email             String
  isAnonymous       Boolean       @default(false)
  totalDonatedCents Int           @default(0)
  donationCount     Int           @default(0)
  lastDonatedAt     DateTime?
  dwollaCustomerId  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  donations         CollectiveDonation[]

  @@index([collectiveId])
  @@index([email])
  @@unique([collectiveId, email])
}

model CollectiveDonation {
  id               String          @id @default(cuid())
  donorId          String
  donor            CollectiveDonor @relation(fields: [donorId], references: [id], onDelete: Cascade)
  collectiveId     String
  collective       NilCollective   @relation(fields: [collectiveId], references: [id])
  amountCents      Int
  currency         String          @default("USD")
  dwollaTransferId String?
  status           String          @default("COMPLETED") // PENDING, COMPLETED, FAILED, REFUNDED
  note             String?
  isRecurring      Boolean         @default(false)
  donatedAt        DateTime        @default(now())
  createdAt        DateTime        @default(now())

  @@index([donorId])
  @@index([collectiveId])
  @@index([status])
  @@index([donatedAt])
}

model CollectiveDistribution {
  id               String           @id @default(cuid())
  collectiveId     String
  collective       NilCollective    @relation(fields: [collectiveId], references: [id])
  memberId         String
  member           CollectiveMember @relation(fields: [memberId], references: [id])
  athleteId        String
  amountCents      Int
  currency         String           @default("USD")
  reason           String
  periodStart      DateTime
  periodEnd        DateTime
  dwollaTransferId String?
  paidAt           DateTime?
  status           String           @default("PENDING") // PENDING, PROCESSING, PAID, FAILED
  taxYear          Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([collectiveId])
  @@index([memberId])
  @@index([athleteId])
  @@index([status])
  @@index([taxYear])
}

// ═══════════════════════════════════════════════════════════════════════════════
// AI Matchmaking — Brand × Creator / Athlete Pairing Engine
// ═══════════════════════════════════════════════════════════════════════════════

enum MatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model MatchRequest {
  id                  String      @id @default(cuid())
  requestedById       String
  requestedBy         User        @relation(fields: [requestedById], references: [id])
  campaignId          String?
  brief               String      @db.Text  // plain-text campaign brief
  budgetCents         Int?                  // max per creator/athlete
  targetNiche         String[]
  targetPlatforms     String[]
  targetMinFollowers  Int?
  targetMaxFollowers  Int?
  targetMinEngagement Float?
  targetEntityType    String      @default("creator") // creator | athlete | both
  targetSport         String?     // for athlete matching
  maxResults          Int         @default(10)
  status              MatchStatus @default(PENDING)
  results             MatchResult[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
}

model MatchResult {
  id                 String       @id @default(cuid())
  requestId          String
  request            MatchRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creatorId          String?
  creator            Creator?     @relation(fields: [creatorId], references: [id])
  athleteId          String?
  athlete            Athlete?     @relation(fields: [athleteId], references: [id])
  rank               Int
  matchScore         Float        // 0-100 overall match quality
  audienceAlignScore Float        // 0-100 audience alignment to brief
  performanceScore   Float        // 0-100 predicted performance
  fraudScore         Float        // 0-100 fraud risk (lower = better)
  suggestedRateCents Int?         // AI-suggested deal rate
  estimatedReach     Int?
  estimatedRoi       Float?
  reasoning          String       @db.Text
  aiFlags            Json?
  createdAt          DateTime     @default(now())

  @@index([requestId])
  @@index([creatorId])
  @@index([athleteId])
  @@index([rank])
}


// ─── Social Accounts (profile builder) ──────────────────────────────────────

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  X
  FACEBOOK
  TWITCH
  LINKEDIN
  SNAPCHAT
  PINTEREST
  THREADS
  OTHER
}

enum SocialVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

/// A social account linked by a creator or athlete during profile setup.
/// Polymorphic owner via nullable creatorId/athleteId (mirrors MatchResult).
model SocialAccount {
  id                 String                   @id @default(cuid())
  ownerType          String                   // "creator" | "athlete"
  creatorId          String?
  creator            Creator?                 @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  athleteId          String?
  athlete            Athlete?                 @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  platform           SocialPlatform
  handle             String
  url                String?
  followerCount      Int?
  isPrimary          Boolean                  @default(false)
  verificationStatus SocialVerificationStatus @default(UNVERIFIED)
  verificationMethod String?                  // "ownership_code" | "oauth" | "manual"
  verificationCode   String?                  // code the owner must post to prove ownership
  verifiedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([creatorId, platform, handle])
  @@unique([athleteId, platform, handle])
  @@index([creatorId])
  @@index([athleteId])
  @@index([platform, handle])
  @@index([ownerType])
}

// ─── Anti-disintermediation ─────────────────────────────────────────────────

/// Records a detected attempt to move a relationship off-platform (contact
/// details shared in a deal room) or an audited contact reveal.
model CircumventionFlag {
  id             String   @id @default(cuid())
  kind           String   // "message_contact" | "contact_reveal"
  severity       String   // "low" | "medium" | "high"
  contractId     String?
  dealRoomId     String?
  actorUserId    String   // who triggered the flag (message author / brand)
  brandId        String?
  targetType     String?  // "creator" | "athlete"
  targetId       String?
  categories     String[] // e.g. ["email","phone","offplatform_invite"]
  detail         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([brandId])
  @@index([dealRoomId])
  @@index([createdAt])
}
