{
  "name": "conic-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "db:migrate": "npm run --workspace @conic/backend db:migrate",
    "db:studio": "npm run --workspace @conic/backend db:studio",
    "db:seed": "npm run --workspace @conic/backend db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.46.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@nestjs/core": "^11.1.28",
    "@nestjs/common": "^11.1.28",
    "rxjs": "^7.8.2"
  }
}
