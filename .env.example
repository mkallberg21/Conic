# ============================================================
# Conic Platform — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database ----
DATABASE_URL=postgresql://conic:conic_secret@localhost:5432/conic

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Dwolla ACH Payments ----
DWOLLA_KEY=your-dwolla-app-key
DWOLLA_SECRET=your-dwolla-app-secret
DWOLLA_ENVIRONMENT=sandbox
# URL of the platform's master Dwolla funding source (where payouts originate)
DWOLLA_MASTER_FUNDING_SOURCE_URL=https://api-sandbox.dwolla.com/funding-sources/...
PLATFORM_FEE_RATE=0.05

# ---- OpenAI ----
OPENAI_API_KEY=sk-...

# ---- AI Microservice URLs ----
CONTRACT_AI_URL=http://localhost:8001
DELIVERABLE_AI_URL=http://localhost:8002
CREATOR_GRAPH_AI_URL=http://localhost:8003
PRICING_ENGINE_AI_URL=http://localhost:8004
CAMPAIGN_AGENT_AI_URL=http://localhost:8005
PERFORMANCE_PREDICTION_AI_URL=http://localhost:8006

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- App ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000

# ---- Legacy (apps/api) ----
API_PORT=4000
WEB_PORT=5173
ALLOWED_ORIGIN=http://localhost:5173
PAYMENT_PROVIDER=dwolla
PAYMENT_SETTLEMENT_DAYS=2

# ---- Email (SendGrid) ----
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@conic.io

# ---- Observability (OpenTelemetry) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9464

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
