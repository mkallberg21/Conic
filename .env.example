# ─────────────────────────────────────────────────────────────────────────────
# CONIC — Environment Variable Reference
# Copy this file to .env and fill in real values before starting any service.
# NEVER commit .env to version control.
#
# Generate strong tokens with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=conic
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
POSTGRES_DB=conic

DATABASE_URL=postgresql://conic:CHANGE_ME_strong_password_here@localhost:5432/conic
DATABASE_DIRECT_URL=postgresql://conic:CHANGE_ME_strong_password_here@localhost:5432/conic

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Both MUST be unique random values — generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_different_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Internal Service Auth ─────────────────────────────────────────────────────
# Shared secret used by NestJS backend to authenticate calls to AI services.
# ALL AI containers MUST have this set or they will refuse to start in production.
# Generate: openssl rand -base64 32
INTERNAL_API_SECRET=CHANGE_ME_generate_with_openssl

# ── Dwolla ACH Payments ───────────────────────────────────────────────────────
DWOLLA_KEY=your-dwolla-app-key
DWOLLA_SECRET=your-dwolla-app-secret
DWOLLA_ENVIRONMENT=sandbox
DWOLLA_MASTER_FUNDING_SOURCE_URL=https://api-sandbox.dwolla.com/funding-sources/...
PLATFORM_FEE_RATE=0.05

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── AI Microservice URLs ──────────────────────────────────────────────────────
CONTRACT_AI_URL=http://localhost:8001
DELIVERABLE_AI_URL=http://localhost:8002
CREATOR_GRAPH_AI_URL=http://localhost:8003
PRICING_ENGINE_AI_URL=http://localhost:8004
CAMPAIGN_AGENT_AI_URL=http://localhost:8005
PERFORMANCE_PREDICTION_AI_URL=http://localhost:8006
NIL_COMPLIANCE_AI_URL=http://localhost:8007
FRAUD_DETECTION_AI_URL=http://localhost:8008

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/v1/auth/google/callback

# ── Mobile (Expo) ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# ── App Store / Google Play submission (secrets — do NOT commit real values) ────
# These are configured as EAS secrets (`eas secret:set`) or CI/CD env vars, never
# committed to .env. Documented here so the .env-centric view of required secrets
# is complete.
#
# iOS (App Store Connect):
#   appleId       — email used to sign in to App Store Connect
#   ascAppId      — App Store Connect API Key ID (Users → Keys)
#   appleTeamId   — 10-character Apple Developer team ID
#
# Android (Google Play):
#   google-service-account.json — service account with Google Play Release permissions
#
# The actual values live in eas.json submit.production and are provisioned via the
# EAS CLI, not via .env. Full workflow documented in apps/mobile/MOBILE_STORE_READINESS.md.
CORS_ORIGIN=http://localhost:3000

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_ENV=development
PORT=4000

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=noreply@conic.io

# ---- Observability (OpenTelemetry) ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9464

# ---- Mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
